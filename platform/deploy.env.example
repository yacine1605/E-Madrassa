# A deployment's settings: copy to deploy.env (never committed), or let deploy/new-env.sh write
# it with fresh secrets. Then: docker compose --env-file deploy.env up -d --build
COMPOSE_PROJECT_NAME=madrassa-platform

# Public address. SITE_ADDRESS is the name Caddy obtains a certificate for (Let's Encrypt for a
# public name; its local authority for `localhost`).
APP_URL=https://localhost:8443
SITE_ADDRESS=localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# Database: the owner (migrations only), then the restricted roles' passwords: the schools'
# application, the console, the sign-in.
DB_DATABASE=madrassa
DB_OWNER_USERNAME=platform_owner
DB_OWNER_PASSWORD=
DB_RUNTIME_PASSWORD=
DB_CONSOLE_PASSWORD=
DB_AUTH_PASSWORD=

# Redis (sessions, cache, job queue).
REDIS_PASSWORD=

# Files (FR-FIC-01). With the bundled Garage: an access key GK + 24 hexadecimal digits, a secret of
# 64, an RPC secret of 64 and an admin token. With another S3 provider: its endpoint, region and
# key, and GARAGE_ADMIN_URL left empty.
FILES_ACCESS_KEY_ID=
FILES_SECRET_ACCESS_KEY=
FILES_BUCKET=madrassa-files
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Email (OD-12). `log` until the provider is chosen.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com

# Backups (`--profile backup`): every day at BACKUP_HOUR, Algeria time, BACKUP_KEEP kept in BACKUP_DIR,
# encrypted with BACKUP_PASSPHRASE (12 characters or more). Keep the passphrase apart from the
# backups: without it, no restoration. Copy BACKUP_DIR regularly to another disk or site.
BACKUP_PASSPHRASE=
BACKUP_HOUR=3
BACKUP_KEEP=14
BACKUP_DIR=./backups

# A dedicated installation (ND-06): the slug of its only school. Empty for the shared platform.
PLATFORM_DEDICATED_SCHOOL=
