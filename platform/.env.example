APP_NAME=Madrassa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# NFR-SEC-02: passwords are hashed with Argon2id.
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=madrassa
DB_SSLMODE=prefer
# One account per database role (deploy/roles.sql). Web requests and jobs use school_runtime.
DB_USERNAME=school_runtime
DB_PASSWORD=
# Publisher console: platform data only, never a school's data.
DB_CONSOLE_USERNAME=platform_admin
DB_CONSOLE_PASSWORD=
# Migration owner: migrations and provisioning commands only, never set for the web server.
DB_OWNER_USERNAME=
DB_OWNER_PASSWORD=
# Dedicated installation (ND-06): the slug of the only school served. Empty for the shared SaaS.
PLATFORM_DEDICATED_SCHOOL=
# Front end that opens activation and recovery links (the token travels in the URL fragment).
PLATFORM_FRONT_URL=http://localhost
PLATFORM_MFA_ISSUER=Madrassa
# Failures before an address waits (FR-IAM-02: 5). Raise it if a school's pupils share one public address.
PLATFORM_LOCKOUT_IP_THRESHOLD=5
# Files (FR-FIC-01): `local` (storage/app/private/files) for development, `s3` in production
# with the AWS_* settings below (MinIO: AWS_ENDPOINT, path-style). Never the container alone.
FILES_DRIVER=local

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=file

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` is for development only: the log then holds activation and recovery links (NFR-SEC-06).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
