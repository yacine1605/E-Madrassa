<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The whole suite runs in one process and passes 128 MB, the CLI's default, with the
             reference import and the photos; a request stays within docker/php.ini's 256 MB. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_LOCALE" value="fr"/>
        <env name="APP_FALLBACK_LOCALE" value="fr"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="HASH_DRIVER" value="argon2id"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- A disposable PostgreSQL 16 database whose name ends in _test; CI and local runs
             override these through the environment. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_URL" value=""/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="platform_test"/>
        <env name="DB_USERNAME" value="school_runtime"/>
        <env name="DB_PASSWORD" value="runtime-test-only"/>
        <env name="DB_CONSOLE_USERNAME" value="platform_admin"/>
        <env name="DB_CONSOLE_PASSWORD" value="console-test-only"/>
        <env name="DB_AUTH_USERNAME" value="platform_auth"/>
        <env name="DB_AUTH_PASSWORD" value="auth-test-only"/>
        <env name="DB_OWNER_USERNAME" value="ci_admin"/>
        <env name="DB_OWNER_PASSWORD" value="ci_admin"/>
        <env name="DB_SSLMODE" value="disable"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
