# Copy once per school, choose a unique project name, port and password.
COMPOSE_PROJECT_NAME=school-a
APP_PORT=8001
APP_URL=http://localhost:8001
DB_DATABASE=school_a
DB_PASSWORD=replace-with-a-unique-local-password
# Feature package for this school: full, school, language_center, training_center, administration.
SCHOOL_PROFILE=school
# Optional custom selection (overrides the profile); dependencies are included automatically.
# SCHOOL_MODULES=students,lifecycle,finance
# Separate private backup directory per school; daily hour in Algeria time, retained copies.
BACKUP_HOUR=3
BACKUP_KEEP=14
# BACKUP_DIR=D:/SchoolBackups/school-a
# Cloudflare Zero Trust tunnel. Set APP_URL to the public HTTPS hostname.
# The tunnel's public hostname must point to http://app:80 in Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
